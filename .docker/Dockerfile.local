FROM debian:12-slim AS peaq-builder

RUN  apt-get update &&  apt-get install -y libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x \
    gstreamer1.0-alsa gstreamer1.0-gl gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 gstreamer1.0-pulseaudio \
    git gtk-doc-tools git2cl automake libtool \
    build-essential autoconf pkg-config m4

RUN git clone https://github.com/HSU-ANT/gstpeaq.git gstpeaq && \
    cd gstpeaq && \
    aclocal && autoheader && ./autogen.sh && \
    sed -i 's/SUBDIRS = src doc/SUBDIRS = src/' Makefile.am && \
    ./configure --libdir=/usr/lib && automake && make && make install


FROM python:3.11-slim-bookworm

# Use the same dependency manager as plc-testbench: uv (pinned to the version
# that generated uv.lock so `uv sync --locked` stays reproducible).
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app/backend

# Toolchain needed to build the native dependencies (e.g. burg-plc).
RUN  apt-get update &&  apt-get install -y \
    build-essential gcc g++ make cmake git

# Copy only the dependency manifests first so the dependency layer is cached
# until the lock files change. `plctestbench` is an editable path dependency
# (`../plc-testbench`), so its pyproject is required for the resolution.
COPY plc-platform-backend/pyproject.toml plc-platform-backend/uv.lock ./
COPY plc-testbench/pyproject.toml /app/plc-testbench/pyproject.toml

# Install third-party dependencies only: skip the backend project and the
# editable `plctestbench` path dependency (its sources are not copied yet).
RUN uv sync --locked --no-install-project --no-install-package plctestbench

# Copy the sources and finish the installation (backend + development group).
COPY ./plc-platform-backend ./
COPY ./plc-testbench /app/plc-testbench

RUN uv sync --locked

RUN  apt-get update &&  apt-get install -y libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x \
    gstreamer1.0-alsa gstreamer1.0-gl gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 gstreamer1.0-pulseaudio \
    gtk-doc-tools git2cl automake libtool \
    build-essential autoconf pkg-config m4

COPY --from=peaq-builder --chmod=755 /usr/lib/gstreamer-1.0/ /usr/lib/gstreamer-1.0/

COPY --from=peaq-builder --chmod=755 /usr/local/bin/peaq /usr/local/bin/peaq

RUN chmod u+x .docker/docker-entrypoint.workers.sh

RUN chmod u+x .docker/docker-entrypoint.backend.dev.sh
